# Copy to .env for development. Never commit real credentials.
ADMIN_PASSWORD=replace-with-a-long-unique-password
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=replace-with-at-least-32-random-characters
HOST=127.0.0.1
PORT=4317
SURVEY_DB_PATH=.data/survey.sqlite
# Set true only after configuring HTTPS. Keep false for the SSH preview.
COOKIE_SECURE=false
